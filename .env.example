# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string (pooled URL recommended for the app)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dwelling_fee?sslmode=require

# ── LLM provider (Vercel AI SDK) ──────────────────────────────────────────────
# Which provider to use for extraction: anthropic | openai | google
AI_PROVIDER=anthropic
# Optional: override the model id (defaults per provider:
#   anthropic=claude-haiku-4.5  openai=gpt-4.1-mini  google=gemini-2.5-flash)
# AI_EXTRACTION_MODEL=claude-haiku-4.5

# Only the selected provider's key is required:
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
