# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string (pooled URL recommended for the app)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dwelling_fee?sslmode=require

# ── LLM provider (Vercel AI SDK) ──────────────────────────────────────────────
# Which provider to use for extraction: anthropic | openai | google
AI_PROVIDER=anthropic
# Optional: override the model id (defaults per provider:
#   anthropic=claude-haiku-4.5  openai=gpt-4.1-mini  google=gemini-2.5-flash)
# AI_EXTRACTION_MODEL=claude-haiku-4.5
# Optional: override the ADK model used by the conversational ingest agent.
# Non-Gemini models use adk-llm-bridge provider/model names:
#   openai/gpt-4.1-mini, anthropic/claude-haiku-4.5
# Gemini can still use native ADK model names:
#   gemini-2.5-flash
# ADK_INGEST_MODEL=openai/gpt-4.1-mini

# Only the selected provider's key is required:
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=...  # Also used by native Gemini ADK when GEMINI_API_KEY is unset.

# ── Internet research tools ─────────────────────────────────────────────────
# Optional. Enables the Tier 2 project/building information search tool used by
# agent workflows for unconfirmed research context.
# BRAVE_SEARCH_API_KEY=...

# ── R2 image storage ────────────────────────────────────────────────────────
# S3-compatible endpoint; may include the bucket path, e.g.
# https://<account>.r2.cloudflarestorage.com/dwelling-fee
R2_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com/dwelling-fee
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
# Optional public/custom domain. If absent, stored attachment URLs use R2_S3_ENDPOINT.
# R2_PUBLIC_BASE_URL=https://media.example.com

# ── Auth (Auth.js / NextAuth v5 — Google sign-in) ────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-random-32-byte-base64
# Google OAuth 2.0 Web client credentials (Google Cloud Console → Credentials).
# Authorized redirect URI must include: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=xxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-...
# Comma-separated allowlist of Google accounts permitted to use the app.
AUTH_ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com

# ── Local edge crawler worker ────────────────────────────────────────────────
# Local-only values returned by /edge-devices when registering a device.
# Do not set these in Vercel.
# EDGE_SERVER_URL=https://dwelling-fee.vercel.app
# EDGE_DEVICE_ID=...
# EDGE_DEVICE_SECRET=df_edge_...
# EDGE_PROFILE_DIR=.edge-profile/default
# EDGE_HEADLESS=false
# EDGE_ONCE=false
