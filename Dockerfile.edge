# Production Docker container image for Edge Device Worker + noVNC Appliance
FROM mcr.microsoft.com/playwright:v1.49.0-noble

# Install Xvfb, x11vnc, noVNC, websockify, supervisord, and base utilities
RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    supervisor \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency manifests and install packages
COPY package*.json ./
RUN npm ci
RUN npx playwright install chrome

# Copy application source code
COPY . .

# Create volume mount points for persistent Chromium profile and logs
RUN mkdir -p /app/.edge-profile /app/.edge-logs

# Environment defaults for containerized run
ENV DISPLAY=:99
ENV EDGE_HEADLESS=false
ENV EDGE_CHROMIUM_SANDBOX=false
ENV EDGE_PROFILE_DIR=/app/.edge-profile/default
ENV EDGE_BIND_HOST=0.0.0.0
ENV EDGE_VNC_PORT=5900
ENV EDGE_NOVNC_PORT=6080

EXPOSE 6080

CMD ["/usr/bin/supervisord", "-c", "/app/scripts/supervisord.conf"]
